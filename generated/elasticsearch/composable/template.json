{
  "_meta": {
    "description": "Sample composable template that includes all ECS fields",
    "ecs_version": "8.7.0"
  },
  "composed_of": [
    "ecs_8.7.0_arcsight",
    "ecs_8.7.0_aws",
    "ecs_8.7.0_auditd",
    "ecs_8.7.0_beyondtrust",
    "ecs_8.7.0_bpr",
    "ecs_8.7.0_cas",
    "ecs_8.7.0_cisco_duo_admin",
    "ecs_8.7.0_cisco_duo_auth",
    "ecs_8.7.0_grouper",
    "ecs_8.7.0_ldap",
    "ecs_8.7.0_logstash",
    "ecs_8.7.0_malware",
    "ecs_8.7.0_nat_allocation",
    "ecs_8.7.0_packet",
    "ecs_8.7.0_prisma",
    "ecs_8.7.0_redcap",
    "ecs_8.7.0_shibboleth",
    "ecs_8.7.0_suricata",
    "ecs_8.7.0_system",
    "ecs_8.7.0_ticket",
    "ecs_8.7.0_user",
    "ecs_8.7.0_base",
    "ecs_8.7.0_agent",
    "ecs_8.7.0_client",
    "ecs_8.7.0_cloud",
    "ecs_8.7.0_container",
    "ecs_8.7.0_data_stream",
    "ecs_8.7.0_destination",
    "ecs_8.7.0_device",
    "ecs_8.7.0_dll",
    "ecs_8.7.0_dns",
    "ecs_8.7.0_ecs",
    "ecs_8.7.0_email",
    "ecs_8.7.0_error",
    "ecs_8.7.0_event",
    "ecs_8.7.0_faas",
    "ecs_8.7.0_file",
    "ecs_8.7.0_group",
    "ecs_8.7.0_host",
    "ecs_8.7.0_http",
    "ecs_8.7.0_log",
    "ecs_8.7.0_network",
    "ecs_8.7.0_observer",
    "ecs_8.7.0_orchestrator",
    "ecs_8.7.0_organization",
    "ecs_8.7.0_package",
    "ecs_8.7.0_process",
    "ecs_8.7.0_registry",
    "ecs_8.7.0_related",
    "ecs_8.7.0_rule",
    "ecs_8.7.0_server",
    "ecs_8.7.0_service",
    "ecs_8.7.0_source",
    "ecs_8.7.0_threat",
    "ecs_8.7.0_tls",
    "ecs_8.7.0_tracing",
    "ecs_8.7.0_url",
    "ecs_8.7.0_user_agent",
    "ecs_8.7.0_vulnerability"
  ],
  "index_patterns": [
    "try-ecs-*"
  ],
  "priority": 1,
  "template": {
    "mappings": {
      "date_detection": false,
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "mapping": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "match_mapping_type": "string"
          }
        }
      ]
    },
    "settings": {
      "index": {
        "codec": "best_compression",
        "mapping": {
          "total_fields": {
            "limit": 2000
          }
        }
      }
    }
  }
}
