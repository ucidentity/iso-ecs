{
  "_meta": {
    "documentation": "https://www.elastic.co/guide/en/ecs/current/ecs-cisco_duo_auth.html",
    "ecs_version": "8.7.0"
  },
  "template": {
    "mappings": {
      "properties": {
        "cisco_duo_auth": {
          "properties": {
            "access_device": {
              "properties": {
                "flash_version": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "hostname": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "ip": {
                  "type": "ip"
                },
                "is_encryption_enabled": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "is_firewall_enabled": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "is_password_set": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "java_version": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "location": {
                  "properties": {
                    "city": {
                      "ignore_above": 1024,
                      "type": "keyword"
                    },
                    "country": {
                      "ignore_above": 1024,
                      "type": "keyword"
                    },
                    "state": {
                      "ignore_above": 1024,
                      "type": "keyword"
                    }
                  }
                },
                "security_agents": {
                  "ignore_above": 1024,
                  "type": "keyword"
                }
              }
            },
            "alias": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "application": {
              "properties": {
                "key": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "name": {
                  "ignore_above": 1024,
                  "type": "keyword"
                }
              }
            },
            "auth_device": {
              "properties": {
                "as": {
                  "properties": {
                    "number": {
                      "type": "long"
                    },
                    "organization": {
                      "properties": {
                        "name": {
                          "ignore_above": 1024,
                          "type": "keyword"
                        }
                      }
                    }
                  }
                },
                "geo": {
                  "properties": {
                    "city_name": {
                      "ignore_above": 1024,
                      "type": "keyword"
                    },
                    "continent_name": {
                      "ignore_above": 1024,
                      "type": "keyword"
                    },
                    "country_iso_code": {
                      "ignore_above": 1024,
                      "type": "keyword"
                    },
                    "country_name": {
                      "ignore_above": 1024,
                      "type": "keyword"
                    },
                    "location": {
                      "type": "geo_point"
                    },
                    "region_iso_code": {
                      "ignore_above": 1024,
                      "type": "keyword"
                    },
                    "region_name": {
                      "ignore_above": 1024,
                      "type": "keyword"
                    }
                  }
                },
                "ip": {
                  "type": "ip"
                },
                "location": {
                  "properties": {
                    "city": {
                      "ignore_above": 1024,
                      "type": "keyword"
                    },
                    "country": {
                      "ignore_above": 1024,
                      "type": "keyword"
                    },
                    "state": {
                      "ignore_above": 1024,
                      "type": "keyword"
                    }
                  }
                },
                "name": {
                  "ignore_above": 1024,
                  "type": "keyword"
                }
              }
            },
            "email": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "event_type": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "factor": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "ood_software": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "reason": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "result": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "trusted_endpoint_status": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "txid": {
              "ignore_above": 1024,
              "type": "keyword"
            }
          }
        }
      }
    }
  }
}
