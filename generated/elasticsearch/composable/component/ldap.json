{
  "_meta": {
    "documentation": "https://www.elastic.co/guide/en/ecs/current/ecs-ldap.html",
    "ecs_version": "8.2.1"
  },
  "template": {
    "mappings": {
      "properties": {
        "ldap": {
          "properties": {
            "attributes": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "base": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "category": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "filter": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "message": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "oid": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "operation": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "request_controls": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "result": {
              "properties": {
                "code": {
                  "type": "integer"
                },
                "count": {
                  "type": "long"
                }
              }
            },
            "scope": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "type": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "version": {
              "ignore_above": 1024,
              "type": "keyword"
            }
          }
        }
      }
    }
  }
}
